      "title": "Temperatura per estança",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "mysql_veinat" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, $__interval), REPLACE(entitat, 'SensorAmbient:Veinat:', '') AS metric, AVG(valor_num) AS value FROM historic WHERE atribut = 'temperatura_c' AND $__timeFilter(ts) GROUP BY 1, metric ORDER BY 1",
